# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection
# Local development:
MONGO_URI=mongodb://localhost:27017/academic_portal
# Vercel / Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/academic_portal?retryWrites=true&w=majority

# Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Optional: Frontend URL for CORS in production (if separate domains)
# FRONTEND_URL=https://your-frontend.vercel.app
